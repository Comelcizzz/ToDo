{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastering.audio/schemas/research-example-v1.schema.json",
  "title": "Mastering Audio metadata-only research example",
  "type": "object",
  "required": ["schemaVersion", "kind", "privacy", "project"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "mastering-audio-research-example" },
    "privacy": {
      "type": "object",
      "required": [
        "audioIncluded",
        "pathsIncluded",
        "namesIncluded",
        "exportIsUserInitiated"
      ],
      "properties": {
        "audioIncluded": { "const": false },
        "pathsIncluded": { "const": false },
        "namesIncluded": { "const": false },
        "exportIsUserInitiated": { "const": true }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": [
        "anonymousId",
        "sampleRate",
        "trackCount",
        "selectedVariant",
        "userApproved",
        "tracks"
      ],
      "properties": {
        "anonymousId": { "type": "string" },
        "sampleRate": { "type": "number", "exclusiveMinimum": 0 },
        "trackCount": { "type": "integer", "minimum": 1 },
        "selectedVariant": {
          "enum": ["balanced", "punchy", "vocal-forward"]
        },
        "userApproved": { "const": true },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["index", "role", "metrics", "approvedSettings"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "role": { "type": "string" },
              "metrics": { "type": "object" },
              "approvedSettings": { "type": "object" }
            }
          }
        }
      }
    }
  }
}
